modules = ["nodejs-20", "web", "bash", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CKYC Manager"

[[workflows.workflow]]
name = "CKYC Manager"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "sh -c 'PORT=8080 pnpm --filter @workspace/api-server run dev & API_PID=$!; trap \"kill $API_PID 2>/dev/null || true\" EXIT INT TERM; PORT=21959 BASE_PATH=/ pnpm --filter @workspace/ckyc-manager run dev'"
waitForPort = 21959

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
